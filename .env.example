# MercadoPago credentials — get from https://www.mercadopago.com.mx/developers/panel
# Use TEST credentials for local development (they start with TEST-)
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_PUBLIC_KEY=TEST-your-public-key-here

# Server config
PORT=3000

# Public base URL used for back_urls and notification_url.
# For local dev: http://localhost:3000 (cards work, but webhooks won't fire)
# For webhook testing: use an ngrok HTTPS URL, e.g. https://abc123.ngrok.app
BASE_URL=http://localhost:3000
